# Tenorio3G Platform text standard
# Repository text files use LF consistently.

* text=auto

*.py      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.ini     text eol=lf
*.cfg     text eol=lf
*.toml    text eol=lf

# Windows scripts keep their native line endings.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary files must never be line-ending normalized.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.db      binary
*.sqlite  binary
*.sqlite3 binary
